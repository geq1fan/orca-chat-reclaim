{
  "manifestVersion": 2,
  "id": "chat-reclaim",
  "name": "会话资源",
  "version": "0.1.3",
  "description": "按工作区列出 agent 会话，逐个或批量关闭空闲（done）会话，补上 Orca 资源面板缺失的关闭按钮。",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "chat-reclaim",
        "title": "会话资源",
        "icon": "agent",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "terminal:send"
    }
  ],
  "screenshots": [
    {
      "path": "assets/screenshot.png",
      "alt": "会话资源面板：顶部「Orca 会话 14 条 · 匹配到进程 7 条」，小小分组展开 4 条运行中会话（600d75f6、13d8d80f、dd411755、82092408），标题分别对应「未匹配到题目问题排查」「上线 dsl-hub…」「Home」「分析当前 Mac 内存占用」，另有两行标「无法判定」",
      "caption": "进程、会话 id 与标题一一对应，逐个或一键回收"
    }
  ]
}